# Server only — never prefix with VITE_
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Nango sync (Stripe checkout-sessions → barn)
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=
NANGO_INTEGRATION_ID=stripe
NANGO_CONNECTION_ID=ash-cow
NANGO_SYNC_NAME=checkout-sessions
NANGO_MODEL=CheckoutSession

# Optional. Used if Stripe is off, so buyers still hit your Gumroad/PayPal URL.
VITE_PAY_URL=
VITE_AUTH_ENABLED=false
