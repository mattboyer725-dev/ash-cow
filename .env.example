# Server only — never prefix with VITE_ (that inlines into the browser).
# Use a restricted key (rk_test_ / rk_live_) with Checkout Sessions write.
# Do not put Clarvis/local-agent secrets in git.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Canonical public origin for webhook URLs and Stripe success_url.
# Falls back to the request Origin / Host headers when empty.
PUBLIC_ORIGIN=

# Nango sync (Stripe checkout-sessions → barn)
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=
NANGO_INTEGRATION_ID=stripe
NANGO_CONNECTION_ID=ash-cow
NANGO_SYNC_NAME=checkout-sessions
NANGO_MODEL=CheckoutSession
# vercel/ms notation. Min 30 seconds. Default from the Stripe template is every hour.
NANGO_SYNC_FREQUENCY=every hour

# Locks kick/inspect/ingest. Leave empty in preview.
OPERATOR_SECRET=

# Optional. Used if Stripe is off, so buyers still hit your Gumroad/PayPal URL.
VITE_PAY_URL=
VITE_AUTH_ENABLED=false
